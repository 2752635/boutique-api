digraph G {
  graph [rankdir=LR, fontname="Helvetica", splines=spline, nodesep=0.6, ranksep=1.1, label="Boutique API - Modèle physique (MySQL)", labelloc=t, fontsize=20];
  node [shape=plaintext, fontname="Helvetica", fontsize=11];
  edge [arrowhead=crow, arrowtail=tee, dir=both, color="#555555"];
  roles [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#2E5E8C" colspan="2"><font color="white"><b>roles</b></font></td></tr><tr><td align="left"><b>PK</b> id</td><td align="left">INT AI</td></tr><tr><td align="left">nom</td><td align="left">VARCHAR(50) UQ</td></tr><tr><td align="left">description</td><td align="left">VARCHAR(255)</td></tr><tr><td align="left">createdAt / updatedAt</td><td align="left">DATETIME</td></tr></table>>];
  users [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#2E5E8C" colspan="2"><font color="white"><b>users</b></font></td></tr><tr><td align="left"><b>PK</b> id</td><td align="left">INT AI</td></tr><tr><td align="left">nom</td><td align="left">VARCHAR(100)</td></tr><tr><td align="left">prenom</td><td align="left">VARCHAR(100)</td></tr><tr><td align="left">email</td><td align="left">VARCHAR(150) UQ</td></tr><tr><td align="left">motDePasse</td><td align="left">VARCHAR(255)</td></tr><tr><td align="left">photo</td><td align="left">VARCHAR(255)</td></tr><tr><td align="left"><b>FK</b> roleId</td><td align="left">INT</td></tr><tr><td align="left">createdAt / updatedAt</td><td align="left">DATETIME</td></tr></table>>];
  categories [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#3B7D4F" colspan="2"><font color="white"><b>categories</b></font></td></tr><tr><td align="left"><b>PK</b> id</td><td align="left">INT AI</td></tr><tr><td align="left">nom</td><td align="left">VARCHAR(100) UQ</td></tr><tr><td align="left">description</td><td align="left">TEXT</td></tr><tr><td align="left">image</td><td align="left">VARCHAR(255)</td></tr><tr><td align="left">createdAt / updatedAt</td><td align="left">DATETIME</td></tr></table>>];
  products [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#3B7D4F" colspan="2"><font color="white"><b>products</b></font></td></tr><tr><td align="left"><b>PK</b> id</td><td align="left">INT AI</td></tr><tr><td align="left">nom</td><td align="left">VARCHAR(150)</td></tr><tr><td align="left">description</td><td align="left">TEXT</td></tr><tr><td align="left">prix</td><td align="left">DECIMAL(10,2)</td></tr><tr><td align="left">stock</td><td align="left">INT</td></tr><tr><td align="left">image</td><td align="left">VARCHAR(255)</td></tr><tr><td align="left"><b>FK</b> categoryId</td><td align="left">INT</td></tr><tr><td align="left">createdAt / updatedAt</td><td align="left">DATETIME</td></tr></table>>];
  orders [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#8C5A2E" colspan="2"><font color="white"><b>orders</b></font></td></tr><tr><td align="left"><b>PK</b> id</td><td align="left">INT AI</td></tr><tr><td align="left">statut</td><td align="left">ENUM</td></tr><tr><td align="left">total</td><td align="left">DECIMAL(10,2)</td></tr><tr><td align="left"><b>FK</b> userId</td><td align="left">INT</td></tr><tr><td align="left"><b>FK</b> addressId</td><td align="left">INT NULL</td></tr><tr><td align="left">createdAt / updatedAt</td><td align="left">DATETIME</td></tr></table>>];
  order_items [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#8C5A2E" colspan="2"><font color="white"><b>order_items</b></font></td></tr><tr><td align="left"><b>PK</b> id</td><td align="left">INT AI</td></tr><tr><td align="left">quantite</td><td align="left">INT</td></tr><tr><td align="left">prixUnitaire</td><td align="left">DECIMAL(10,2)</td></tr><tr><td align="left"><b>FK</b> orderId</td><td align="left">INT</td></tr><tr><td align="left"><b>FK</b> productId</td><td align="left">INT</td></tr><tr><td align="left">createdAt / updatedAt</td><td align="left">DATETIME</td></tr></table>>];
  reviews [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#6B3E8C" colspan="2"><font color="white"><b>reviews</b></font></td></tr><tr><td align="left"><b>PK</b> id</td><td align="left">INT AI</td></tr><tr><td align="left">note</td><td align="left">INT (1-5)</td></tr><tr><td align="left">commentaire</td><td align="left">TEXT</td></tr><tr><td align="left"><b>FK</b> userId</td><td align="left">INT</td></tr><tr><td align="left"><b>FK</b> productId</td><td align="left">INT</td></tr><tr><td align="left">createdAt / updatedAt</td><td align="left">DATETIME</td></tr></table>>];
  addresses [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td bgcolor="#6B3E8C" colspan="2"><font color="white"><b>addresses</b></font></td></tr><tr><td align="left"><b>PK</b> id</td><td align="left">INT AI</td></tr><tr><td align="left">rue</td><td align="left">VARCHAR(255)</td></tr><tr><td align="left">ville</td><td align="left">VARCHAR(100)</td></tr><tr><td align="left">province</td><td align="left">VARCHAR(100)</td></tr><tr><td align="left">codePostal</td><td align="left">VARCHAR(10)</td></tr><tr><td align="left">pays</td><td align="left">VARCHAR(100)</td></tr><tr><td align="left">parDefaut</td><td align="left">BOOLEAN</td></tr><tr><td align="left"><b>FK</b> userId</td><td align="left">INT</td></tr><tr><td align="left">createdAt / updatedAt</td><td align="left">DATETIME</td></tr></table>>];
  roles -> users;
  users -> orders;
  users -> reviews;
  users -> addresses;
  addresses -> orders;
  categories -> products;
  orders -> order_items;
  products -> order_items;
  products -> reviews;
}